# ============================================================================
# Variabel lingkungan — Simulasi SKD CPNS
# Salin ke .env dan isi nilai asli:  cp .env.example .env
# ============================================================================

# Koneksi database Neon Postgres (Drizzle ORM + @neondatabase/serverless)
# Ambil dari Neon Console → branch main → Connection string
# Format: postgresql://<user>:<password>@<proxy_host>/<dbname>?sslmode=require
DATABASE_URL=""

# Better Auth — secret minimal 32 karakter (hasil `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# URL aplikasi (development: http://localhost:3000; produksi: domain Vercel)
BETTER_AUTH_URL="http://localhost:3000"

# Email admin (dipisahkan komma) — boleh akses /admin
NEXT_PUBLIC_ADMIN_EMAILS=""

# Nilai minimum lulus (fallback jika passing_grade_config kosong)
PASSING_GRADE_TWK=65
PASSING_GRADE_TIU=80
PASSING_GRADE_TKP=166
